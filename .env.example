# ==========================================
# AI AGENT CONFIGURATION
# ==========================================

# Active Primary Model Choice: 'ollama' | 'minimax' | 'glm'
ACTIVE_MODEL=minimax

# Automatic Fallback Router Settings
ENABLE_AUTO_FALLBACK=true
FALLBACK_ORDER=minimax,glm,ollama

# ==========================================
# 1. OLLAMA CONFIGURATION (Local)
# ==========================================
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ==========================================
# 2. NVIDIA MINIMAX M3 CONFIGURATION
# ==========================================
MINIMAX_API_KEY=nvapi-your-minimax-key-here
MINIMAX_MODEL=minimaxai/minimax-m3
MINIMAX_BASE_URL=https://integrate.api.nvidia.com/v1

# ==========================================
# 3. NVIDIA GLM-5.2 CONFIGURATION
# ==========================================
GLM_API_KEY=nvapi-your-glm-key-here
GLM_MODEL=z-ai/glm-5.2
GLM_BASE_URL=https://integrate.api.nvidia.com/v1

# ------------------------------------------
# General Shared NVIDIA API Key (Optional)
# Used if MINIMAX_API_KEY or GLM_API_KEY is not set
# ------------------------------------------
NVIDIA_API_KEY=

# ==========================================
# Persistent Memory Subsystem Settings
# ==========================================
MEMORY_ENABLED=true
MEMORY_DATABASE=memory/agent_memory.db
MEMORY_RETRIEVAL_LIMIT=5
MEMORY_AUTO_SAVE=true
MEMORY_MIN_IMPORTANCE=3

# ------------------------------------------
# Agent & Workspace Settings
# ------------------------------------------
AGENT_NAME=MyAI-Agent
AGENT_MAX_ITERATIONS=10
AGENT_WORKSPACE=workspace
LOG_LEVEL=INFO